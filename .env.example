# Copy this template to .env and replace the example values.
# Settings.from_env() reads the process environment; it does not load .env.
# Load explicitly with load_settings(env_file=".env") from rag_ingest.bootstrap.
# Existing process environment values take precedence over file values.

# API listening address .
INGEST_API_HOST=0.0.0.0
INGEST_API_PORT=8080

# Required: existing PostgreSQL database.
# Replace credentials and address; URL-encode special characters in credentials.
INGEST_METADATA_DSN=postgresql://ingest_user:CHANGE_ME@localhost:5432/ingestion

# Required: existing S3 bucket and SQS queue.
# These example values do not provision infrastructure.
INGEST_S3_BUCKET=replace-with-your-bucket
INGEST_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/replace-with-your-queue

# Shared region fallback; blank service-specific regions use this value.
AWS_DEFAULT_REGION=ap-south-1
INGEST_S3_REGION=
INGEST_SQS_REGION=

# Optional custom service endpoints. Leave blank for AWS.
INGEST_S3_ENDPOINT_URL=
INGEST_SQS_ENDPOINT_URL=

# Optional AWS SDK environment credentials.
# Uncomment and fill only when using explicit environment credentials.
# Leave unset when credentials will come from an IAM role or another SDK source.
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME
# AWS_SESSION_TOKEN=REPLACE_ME_IF_USING_TEMPORARY_CREDENTIALS

# Execution defaults for NEW work. Persist selected policy with accepted jobs.
# Changing these values must not reset existing jobs' saved budgets.

# Total ownership attempts, INCLUDING the first execution.
INGEST_MAX_ATTEMPTS=5

# Exponential-backoff jitter window; the cap applies to computed backoff.
# Provider minimum retry delays may be longer if the fixed deadline permits.
INGEST_RETRY_BASE_SECONDS=1
INGEST_RETRY_CAP_SECONDS=60

# Repeats allowed after an uncertain outcome or timeout (for example an
# embedding 5xx whose billing is unknown). Each repeat may re-bill a model
# call. 0 makes every uncertain outcome terminal (outcome_requires_inspection).
INGEST_MAX_UNCERTAIN_REPEATS=2

# Builds started at once per tenant. Accepted documents wait (with no deadline
# running) until admitted; deadlines start at admission. Size it so active
# tenants x this value roughly fits your total worker slots.
INGEST_MAX_ACTIVE_GENERATIONS=16

# Uploads hashed at once per scheduler process (verification runs beside the
# scheduler loop, never inside it).
INGEST_VERIFY_CONCURRENCY=2

# Days to keep published notifications, the operation ledger and quarantine
# evidence. Client Idempotency-Keys (delete, reprocess) are honored this long.
INGEST_RETENTION_DAYS=7

# ---- Text recognition (scanned / image pages) --------------------------------
# Recognition uses a Recognizer YOU inject in library mode:
#   build_engine(settings, recognizer=MyRecognizer(...))
# The built-in CLI injects none, so keep text_only there.
# text_only | recognize_unreadable | recognize_with_images | recognize_all
INGEST_EXTRACTION_MODE=text_only
# Pages with visual content but no usable text, when not recognized:
# keep_empty (recorded as "unrecognized" in the page map) or fail the build.
INGEST_UNREADABLE_PAGES=keep_empty
INGEST_MIN_TEXT_CHARS=16
INGEST_RENDER_DPI=200
INGEST_STRICT_PDF=false
# Allow short-lived signed read links for tools that only fetch URLs.
INGEST_ALLOW_SIGNED_URL=false
# Optional: fail a build whose recognized pages report lower confidence.
# INGEST_MIN_CONFIDENCE=0.6
# Runtime limits (not part of the recipe fingerprint):
INGEST_RECOGNITION_CONCURRENCY=4
INGEST_MAX_RECOGNIZED_PAGES=1000
# Billed pages per tenant per UTC day; 0 means no limit.
INGEST_TENANT_DAILY_RECOGNIZED_PAGES=0
INGEST_RECOGNITION_POLL_SECONDS=15

# Maximum job lifetime, including queue waits and retry waits.
INGEST_MAX_JOB_SECONDS=1800

# Fixed maximum duration of one attempt, even if its heartbeats succeed.
INGEST_MAX_ATTEMPT_SECONDS=300

# PostgreSQL ownership lease and heartbeat interval; NOT SQS visibility.
INGEST_LEASE_SECONDS=120
INGEST_HEARTBEAT_SECONDS=30

# Overall processing-generation window, starting at durable acceptance.
# Downstream jobs and retries cannot extend this original deadline.
# Each job deadline is also clamped to the remaining generation window.
INGEST_MAX_GENERATION_SECONDS=3600

# Required: heartbeat < lease <= attempt limit <= job limit.
# Numeric values must not be blank; omit a variable to use its default.
# These are starting defaults, not measured production recommendations.

# API tokens grant tenant-wide access. Replace this sample and bind your tenant.
INGEST_API_TOKENS='{"replace-with-a-long-random-secret-32chars":"11111111-1111-4111-8111-111111111111"}'
INGEST_EMBEDDING_DRIVER=openai
INGEST_EMBEDDING_MODEL=text-embedding-3-small
INGEST_EMBEDDING_DIMENSIONS=1536
INGEST_EMBEDDING_ENCODING=cl100k_base
INGEST_EMBEDDING_API_KEY=CHANGE_ME
# Optional INGEST_VECTOR_DSN defaults to metadata DSN. Bundled search needs same DB.
INGEST_WORKER_CONCURRENCY=2
INGEST_SQS_VISIBILITY_SECONDS=120
INGEST_MULTIPART_THRESHOLD_BYTES=67108864
INGEST_MULTIPART_PART_BYTES=67108864
INGEST_MAX_UPLOAD_BYTES=10737418240
INGEST_MAX_SOURCE_DISK_BYTES=10737418240
INGEST_MAX_EXTRACTED_CHARACTERS=20000000
INGEST_MAX_PAGES=10000
INGEST_CHUNK_SIZE=1000
INGEST_CHUNK_OVERLAP=100
INGEST_EMBEDDING_BATCH_SIZE=64
INGEST_UPLOAD_SECONDS=3600
INGEST_PRESIGN_SECONDS=300
# Logging for the rag-ingest CLI roles: json (one object per line, for log
# pipelines) or text (readable). Levels: DEBUG, INFO, WARNING, ERROR.
INGEST_LOG_FORMAT=json
INGEST_LOG_LEVEL=INFO
# Keep real credentials out of this example file and out of version control.
