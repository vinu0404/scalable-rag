# Local development only. These credentials must never be used for a deployment.
INGEST_METADATA_DSN=postgresql://ingest:ingest_local_password@localhost:5432/ingestion
INGEST_S3_BUCKET=rag-ingest-local
INGEST_S3_REGION=us-east-1
INGEST_SQS_REGION=us-east-1
INGEST_S3_ENDPOINT_URL=http://localhost:4566
INGEST_S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
INGEST_SQS_ENDPOINT_URL=http://localhost:4566
INGEST_SQS_QUEUE_URL=http://localhost:4566/queue/us-east-1/000000000000/ingestion
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
INGEST_API_HOST=127.0.0.1
INGEST_API_PORT=8080
INGEST_API_TOKENS='{"local-development-token-change-me-123456":"11111111-1111-4111-8111-111111111111"}'
# Embeddings: set your key before the first migration (dimensions are fixed then).
INGEST_EMBEDDING_DRIVER=openai
INGEST_EMBEDDING_DIMENSIONS=1536
INGEST_EMBEDDING_MODEL=text-embedding-3-small
INGEST_EMBEDDING_ENCODING=cl100k_base
INGEST_EMBEDDING_API_KEY=your-key
INGEST_WORKER_CONCURRENCY=2
INGEST_MULTIPART_THRESHOLD_BYTES=67108864
INGEST_MULTIPART_PART_BYTES=67108864
INGEST_MAX_UPLOAD_BYTES=10737418240
INGEST_MAX_SOURCE_DISK_BYTES=10737418240
INGEST_MAX_EXTRACTED_CHARACTERS=20000000
INGEST_MAX_PAGES=10000
INGEST_CHUNK_SIZE=1000
INGEST_CHUNK_OVERLAP=100
INGEST_EMBEDDING_BATCH_SIZE=64
INGEST_UPLOAD_SECONDS=3600
INGEST_PRESIGN_SECONDS=300
INGEST_MAX_GENERATION_SECONDS=3600
INGEST_LOG_FORMAT=text
INGEST_LOG_LEVEL=INFO
